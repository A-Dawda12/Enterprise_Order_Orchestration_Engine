<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_order_fulfillment"
                  targetNamespace="http://camunda.org/schema/1.0/bpmn"
                  exporter="order-orchestration-app"
                  exporterVersion="1.1">

  <!--
    v1.1: adds the first real activity, GetOrderForFulfillment (IMPLEMENTATION-PATTERNS §4.1,
    row 1). No explicit zeebe:ioMapping needed — the process variable "orderId" is already
    visible to the job as-is, and the worker's output variable "order" merges back under the
    same name. Explicit ioMapping is only needed once names need to be renamed/scoped.
  -->
  <bpmn:process id="process_order_fulfillment" name="Order Fulfillment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>Flow_StartToGetOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="GetOrderForFulfillment" name="GetOrderForFulfillment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="GetOrderForFulfillment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToGetOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_GetOrderToEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Complete" name="Complete">
      <bpmn:incoming>Flow_GetOrderToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_StartToGetOrder" sourceRef="StartEvent_OrderReceived" targetRef="GetOrderForFulfillment" />
    <bpmn:sequenceFlow id="Flow_GetOrderToEnd" sourceRef="GetOrderForFulfillment" targetRef="EndEvent_Complete" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_order_fulfillment">
      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <omgdc:Bounds x="180" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetOrderForFulfillment_di" bpmnElement="GetOrderForFulfillment">
        <omgdc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Complete_di" bpmnElement="EndEvent_Complete">
        <omgdc:Bounds x="420" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToGetOrder_di" bpmnElement="Flow_StartToGetOrder">
        <omgdi:waypoint x="216" y="118" />
        <omgdi:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetOrderToEnd_di" bpmnElement="Flow_GetOrderToEnd">
        <omgdi:waypoint x="360" y="118" />
        <omgdi:waypoint x="420" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
