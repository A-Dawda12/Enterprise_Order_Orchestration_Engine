      <bpmn:errorEventDefinition id="ErrorEventDefinition_0krfr9j" errorRef="Error_0o9al9l" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_CompensationEntry" name="Compensate">
      <bpmn:incoming>Flow_ShippingFailedToCompensation</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentTimeoutToCompensation</bpmn:incoming>
      <bpmn:incoming>Flow_FraudRejectedToCompensation</bpmn:incoming>
      <bpmn:outgoing>Flow_CompensationEntryToCompensating</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ShippingFailedToCompensation" sourceRef="ErrorShippingFailed" targetRef="Gateway_CompensationEntry" />
    <bpmn:sequenceFlow id="Flow_PaymentTimeoutToCompensation" sourceRef="UpdateOrderStatusToPaymentTimeout" targetRef="Gateway_CompensationEntry" />
    <bpmn:serviceTask id="UpdateOrderStatusToCompensating" name="UpdateOrderStatusToCompensating">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="UpdateOrderStatusToCompensating" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CompensationEntryToCompensating</bpmn:incoming>
      <bpmn:outgoing>Flow_0z3vha7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_CompensationEntryToCompensating" sourceRef="Gateway_CompensationEntry" targetRef="UpdateOrderStatusToCompensating" />
    <bpmn:sequenceFlow id="Flow_FraudRejectedToCompensation" name="rejected" sourceRef="Gateway_FraudApproved" targetRef="Gateway_CompensationEntry" />
    <bpmn:exclusiveGateway id="Gateway_PaymentCompensationType" name="Payment state?" default="Flow_PaymentTypeToSkip">
      <bpmn:incoming>Flow_0z3vha7</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentTypeToRefund</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentTypeToVoid</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentTypeToSkip</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0z3vha7" sourceRef="UpdateOrderStatusToCompensating" targetRef="Gateway_PaymentCompensationType" />
