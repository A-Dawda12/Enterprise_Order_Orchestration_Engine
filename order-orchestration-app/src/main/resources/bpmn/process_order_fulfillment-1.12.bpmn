      <bpmn:incoming>Flow_08krsof</bpmn:incoming>
      <bpmn:outgoing>Flow_1664ig3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0agzyxo" sourceRef="UpdateOrderStatusToFraudReview" targetRef="FraudManagerReview" />
    <bpmn:sequenceFlow id="Flow_FraudGatewayToReview" name="review" sourceRef="Gateway_FraudReviewRequired" targetRef="UpdateOrderStatusToFraudReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresFraudReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08krsof" sourceRef="FraudManagerReview" targetRef="RecordFraudReviewDecision" />
    <bpmn:userTask id="FraudManagerReview" name="FraudManagerReview">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="fraud-managers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0agzyxo</bpmn:incoming>
      <bpmn:outgoing>Flow_08krsof</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FraudApproved" name="Approved?" default="Flow_FraudRejectedToCompensation">
      <bpmn:incoming>Flow_1664ig3</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudApprovedToCapture</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudRejectedToCompensation</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_FraudApprovedToCapture" name="approved" sourceRef="Gateway_FraudApproved" targetRef="CapturePaymentInPaymentService">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1664ig3" sourceRef="RecordFraudReviewDecision" targetRef="Gateway_FraudApproved" />
    <bpmn:boundaryEvent id="TimerPaymentTimeout" name="Payment timeout" attachedToRef="AuthorizePaymentInPaymentService">
      <bpmn:outgoing>Flow_16w7bv3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1hrkkd0">
