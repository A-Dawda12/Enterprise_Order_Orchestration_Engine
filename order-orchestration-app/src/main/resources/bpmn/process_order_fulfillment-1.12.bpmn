    <bpmn:sequenceFlow id="Flow_16w7bv3" sourceRef="TimerPaymentTimeout" targetRef="UpdateOrderStatusToPaymentTimeout" />
    <bpmn:boundaryEvent id="ErrorShippingFailed" name="Shipping failed" attachedToRef="CreateShipmentInShippingService">
