    <bpmn:exclusiveGateway id="Gateway_FraudReviewRequired" name="Review?" default="Flow_FraudGatewayToCapture">
      <bpmn:incoming>Flow_1f024cs</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudGatewayToCapture</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudGatewayToReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1f024cs" sourceRef="UpdateOrderStatusToPaymentPending" targetRef="Gateway_FraudReviewRequired" />
    <bpmn:sequenceFlow id="Flow_FraudGatewayToCapture" name="skip" sourceRef="Gateway_FraudReviewRequired" targetRef="CapturePaymentInPaymentService" />
    <bpmn:serviceTask id="UpdateOrderStatusToFraudReview" name="UpdateOrderStatusToFraudReview">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="UpdateOrderStatusToFraudReview" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FraudGatewayToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_0agzyxo</bpmn:outgoing>
    </bpmn:serviceTask>
