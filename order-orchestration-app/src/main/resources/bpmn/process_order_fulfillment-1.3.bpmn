    <bpmn:sequenceFlow id="Flow_0ly8bcg" sourceRef="ActivityUpdateOrderStatusToValidated_18t02aa" targetRef="EndEvent_Complete" />
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected">
