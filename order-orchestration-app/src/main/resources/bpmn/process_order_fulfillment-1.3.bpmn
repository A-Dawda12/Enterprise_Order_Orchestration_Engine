    <bpmn:sequenceFlow id="Flow_0gkz6ue" sourceRef="ValidateShippingAddress" targetRef="Gateway_ValidationResult" />
    <bpmn:sequenceFlow id="Flow_GatewayToValidated" name="valid" sourceRef="Gateway_ValidationResult" targetRef="ActivityUpdateOrderStatusToValidated_18t02aa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validItems = true and validAddress = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GatewayToRejected" name="Invalid" sourceRef="Gateway_ValidationResult" targetRef="UpdateOrderStatusToRejected" />
