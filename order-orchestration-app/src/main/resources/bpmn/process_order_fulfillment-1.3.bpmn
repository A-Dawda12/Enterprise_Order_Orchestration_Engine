    <bpmn:sequenceFlow id="Flow_0rms0qo" sourceRef="UpdateOrderStatusToRejected" targetRef="EndEvent_Rejected" />
    <bpmn:exclusiveGateway id="Gateway_ValidationResult" name="Valid?" default="Flow_GatewayToRejected">
      <bpmn:incoming>Flow_0gkz6ue</bpmn:incoming>
      <bpmn:outgoing>Flow_GatewayToValidated</bpmn:outgoing>
      <bpmn:outgoing>Flow_GatewayToRejected</bpmn:outgoing>
